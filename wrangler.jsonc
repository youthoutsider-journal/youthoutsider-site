// Cloudflare Workers config for youthoutsider.org
// Build command: node build.js   Deploy command: npx wrangler deploy
{
  "name": "youthoutsider",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  // Sends application emails through Cloudflare Email Routing.
  // The recipient is set as the APPLICATIONS_TO variable in the dashboard, not in this public file.
  "send_email": [{ "name": "MAILER" }],
  "observability": { "enabled": true },
  "keep_vars": true
}
